<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="spawn_z" default="0.8993158340454102"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <param name="robot_description" textfile="$(find urdf_humanoid_arm)/urdf/rig2.urdf"/>
  <node name="spawn_rig2" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model rig2_servo_arm -z $(arg spawn_z)" output="screen"/>
</launch>