FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libgl1 libegl1 libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 \
    libx11-6 libx11-xcb1 libxext6 libxrender1 libxi6 libsm6 libice6 \
    libxcb1 libxcb-glx0 libxcb-render0 libxcb-render-util0 libxcb-shape0 \
    libxcb-randr0 libxcb-xfixes0 libxcb-sync1 libxcb-shm0 libxcb-image0 \
    libxcb-keysyms1 libxcb-icccm4 libxcb-xinerama0 libxcb-xkb1 \
    libxkbcommon-x11-0 libusb-1.0-0 libudev1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/tmp/motorstudio-home QT_X11_NO_MITSHM=1 QT_QPA_PLATFORM=xcb
WORKDIR /opt/motorstudio
CMD ["./AppRun"]