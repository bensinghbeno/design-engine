<?xml version="1.0"?>
<!--
  G1-style shoulder order: crossbar -> pitch (local Y) -> roll (local X)
  -> yaw (local Z) -> upper arm. Three passive, continuous joints.
  This copies the serial axis order, NOT the G1's exact dimensions, tilted
  joint frames, travel limits, motor specifications or internal construction.

  Convention used throughout: every link's own frame sits at the point where
  it attaches to its parent, and the geometry is offset from there. That
  keeps the joint origins trivial and lets the rig rescale cleanly when the
  parameters change.

    stem      - frame at ground level, box pushed up by stem_height/2 so it
                stands ON the ground instead of being half buried. Its top
                face therefore lands at exactly z = stem_height.
    crossbar  - frame at the top of the stem, box pushed up by its own half
                thickness so it rests ON the stem rather than straddling the
                top face.
    pitch_actuator - purple cube bolted to the crossbar end face.
    shoulder_pitch_shaft - gold local-Y output through the green roll cube.
    roll_actuator - green cube carried by pitch, outboard of the crossbar.
    shoulder_roll_shaft - gold local-X output through the cyan yaw cube.
    yaw_actuator - cyan cube carried by roll, stepped forward and down.
    shoulder_yaw_link - gold local-Z output down into the upper arm.
    upper_arm - hangs below yaw, with its centreline on the yaw axis.

  Each output carries everything downstream, but not its own housing.
  Yaw twists the upper arm without moving its centreline tip; pitch and roll
  aim the arm. Yaw is no longer fixed vertical after pitch or roll moves.
  Housings are cubes 20 percent larger than the largest stem/bar section.
  Off-centre shaft mounting steps the yaw housing downward, keeping both
  horizontal shaft bores separate. These are simplified solid housings,
  not machined bores, bearings or gearbox internals. Shafts intentionally
  enter their housings. Full-turn clearance and cable routing are not designed.

  arm_side flips which end it hangs from: +1 or -1 along Y.

  The shoulder joints are deliberately passive: no controller, no PID, just
  damping and friction. The arm falls under gravity and swings like a real
  pendulum, which is the point of the rig.

  Every link needs a non-zero <inertial> or Gazebo silently drops it.

  Masses and inertias follow dimensions. Structural links use wood density;
  actuator housings use an approximate effective assembly density and
  shafts use steel density. These are not measured motor specifications.

  Build standalone:
    xacro urdf/rig.urdf.xacro > rig.urdf
-->
<robot name="arm_rig" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= parameters ================= -->

  <!-- vertical stem -->
  <xacro:arg name="stem_height" default="1.5"/>
  <xacro:arg name="stem_width"  default="0.10"/>
  <xacro:arg name="stem_depth"  default="0.10"/>

  <!-- horizontal crossbar: spans left-right along +/-Y -->
  <xacro:arg name="crossbar_length"    default="1.00"/>
  <xacro:arg name="crossbar_thickness" default="0.08"/>
  <xacro:arg name="crossbar_depth"     default="0.08"/>

  <!-- Structural material density, kg/m^3. Mass is density x volume.

       Wood you can cut at home with a jigsaw:
         450  poplar / pine (softest, lightest)
         500  spruce-pine-fir - standard construction lumber   <- default
         550  softwood ply
         680  birch plywood (stiff, clean edges, heavier)
         750  MDF (blunts blades, no grain, sags over long spans)
         700  oak / ash (hardwood - slow going with a jigsaw)

       Override per build with e.g. density:=680. -->
  <xacro:arg name="density" default="500"/>
  <xacro:property name="rho" value="$(arg density)"/>

  <xacro:property name="sh" value="$(arg stem_height)"/>
  <xacro:property name="sw" value="$(arg stem_width)"/>
  <xacro:property name="sd" value="$(arg stem_depth)"/>
  <xacro:property name="stem_mass" value="${rho*sd*sw*sh}"/>

  <xacro:property name="cl" value="$(arg crossbar_length)"/>
  <xacro:property name="ct" value="$(arg crossbar_thickness)"/>
  <xacro:property name="cd" value="$(arg crossbar_depth)"/>
  <xacro:property name="crossbar_mass" value="${rho*cd*cl*ct}"/>

  <!-- upper arm: hangs from the right end of the crossbar.
       Length is a quarter of the stem height. -->
  <xacro:arg name="upper_arm_width" default="0.07"/>
  <xacro:arg name="upper_arm_depth" default="0.07"/>

  <xacro:property name="ual" value="${sh/4.0}"/>
  <xacro:property name="uaw" value="$(arg upper_arm_width)"/>
  <xacro:property name="uad" value="$(arg upper_arm_depth)"/>
  <xacro:property name="upper_arm_mass" value="${rho*uad*uaw*ual}"/>

  <!-- Effective actuator density approximates a hollow housing plus motor.
       Change to measured mass / external volume when selecting hardware. -->
  <xacro:arg name="actuator_density" default="1200"/>
  <xacro:arg name="shaft_density" default="7800"/>
  <xacro:property name="actuator_rho" value="$(arg actuator_density)"/>
  <xacro:property name="shaft_rho" value="$(arg shaft_density)"/>
  <xacro:property name="actuator_size" value="${1.2*max(sw, sd, ct, cd)}"/>
  <xacro:property name="shaft_radius" value="${actuator_size/10.0}"/>
  <xacro:property name="shaft_gap" value="${actuator_size/3.0}"/>
  <xacro:property name="shaft_cap" value="${actuator_size/10.0}"/>
  <xacro:property name="shaft_insert" value="${actuator_size/5.0}"/>
  <xacro:property name="transfer_shaft_length" value="${shaft_insert+shaft_gap+actuator_size+shaft_cap}"/>
  <xacro:property name="transfer_shaft_center" value="${transfer_shaft_length/2.0-shaft_insert}"/>
  <xacro:property name="next_housing_offset" value="${shaft_gap+actuator_size/2.0}"/>
  <xacro:property name="roll_axis_drop" value="${actuator_size/3.0}"/>
  <xacro:property name="arm_insert" value="${min(ual/4.0, actuator_size/3.0)}"/>
  <xacro:property name="yaw_shaft_length" value="${shaft_insert+shaft_gap+arm_insert}"/>
  <xacro:property name="yaw_shaft_center" value="${yaw_shaft_length/2.0-shaft_insert}"/>

  <!-- which end of the crossbar the arm hangs from: +1 or -1 along Y -->
  <xacro:arg name="arm_side" default="1"/>
  <xacro:property name="side" value="$(arg arm_side)"/>

  <xacro:property name="shoulder_y" value="${side*(cl/2.0+actuator_size/2.0)}"/>
  <xacro:property name="shoulder_z" value="${ct/2.0}"/>

  <!-- Actuator geometry only: joints still use passive damping/friction. -->
  <xacro:property name="shoulder_damping"  value="0.2"/>
  <xacro:property name="shoulder_friction" value="0.1"/>

  <material name="grey">
    <color rgba="0.4 0.4 0.45 1.0"/>
  </material>

  <material name="steel_blue">
    <color rgba="0.25 0.35 0.5 1.0"/>
  </material>

  <material name="copper">
    <color rgba="0.72 0.45 0.20 1.0"/>
  </material>

  <material name="actuator_cyan">
    <color rgba="0.02 0.72 0.85 1"/>
  </material>
  <material name="actuator_purple">
    <color rgba="0.60 0.16 0.82 1"/>
  </material>
  <material name="actuator_green">
    <color rgba="0.18 0.80 0.28 1"/>
  </material>
  <material name="shaft_gold">
    <color rgba="1.0 0.72 0.08 1"/>
  </material>

  <!-- Separate links retain the stator/output relationship and individual
       colours in both URDF viewers and Gazebo's fixed-joint conversion. -->
  <xacro:macro name="actuator_cube" params="name colour gazebo_colour">
    <link name="${name}">
      <visual>
        <geometry><box size="${actuator_size} ${actuator_size} ${actuator_size}"/></geometry>
        <material name="${colour}"/>
      </visual>
      <collision>
        <geometry><box size="${actuator_size} ${actuator_size} ${actuator_size}"/></geometry>
      </collision>
      <inertial>
        <mass value="${actuator_rho*actuator_size**3}"/>
        <inertia ixx="${actuator_rho*actuator_size**5/6.0}" ixy="0" ixz="0"
                 iyy="${actuator_rho*actuator_size**5/6.0}" iyz="0"
                 izz="${actuator_rho*actuator_size**5/6.0}"/>
      </inertial>
    </link>
    <gazebo reference="${name}"><material>${gazebo_colour}</material></gazebo>
  </xacro:macro>

  <xacro:macro name="output_shaft" params="name length xyz rpy">
    <xacro:property name="mass" value="${shaft_rho*pi*shaft_radius**2*length}"/>
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><cylinder radius="${shaft_radius}" length="${length}"/></geometry>
        <material name="shaft_gold"/>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><cylinder radius="${shaft_radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(3*shaft_radius**2+length**2)/12.0}" ixy="0" ixz="0"
                 iyy="${mass*(3*shaft_radius**2+length**2)/12.0}" iyz="0"
                 izz="${mass*shaft_radius**2/2.0}"/>
      </inertial>
    </link>
    <gazebo reference="${name}"><material>Gazebo/Yellow</material></gazebo>
  </xacro:macro>

  <!-- ================= links ================= -->

  <!-- Anchor. A link literally named "world" is what tells Gazebo to weld
       the model to the ground plane. -->
  <link name="world"/>

  <!-- vertical stem -->
  <link name="stem">
    <visual>
      <origin xyz="0 0 ${sh/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${sd} ${sw} ${sh}"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${sh/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${sd} ${sw} ${sh}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${sh/2}" rpy="0 0 0"/>
      <mass value="${stem_mass}"/>
      <!-- solid cuboid about its own centre -->
      <inertia
        ixx="${stem_mass*(sw*sw + sh*sh)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${stem_mass*(sd*sd + sh*sh)/12.0}" iyz="0.0"
        izz="${stem_mass*(sd*sd + sw*sw)/12.0}"/>
    </inertial>
  </link>

  <!-- horizontal crossbar.
       Long axis is Y, so the box is (depth, length, thickness) in X Y Z.
       No rpy needed: the geometry is simply authored wide instead of tall. -->
  <link name="crossbar">
    <visual>
      <origin xyz="0 0 ${ct/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${cd} ${cl} ${ct}"/>
      </geometry>
      <material name="steel_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${ct/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${cd} ${cl} ${ct}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${ct/2}" rpy="0 0 0"/>
      <mass value="${crossbar_mass}"/>
      <inertia
        ixx="${crossbar_mass*(cl*cl + ct*ct)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${crossbar_mass*(cd*cd + ct*ct)/12.0}" iyz="0.0"
        izz="${crossbar_mass*(cd*cd + cl*cl)/12.0}"/>
    </inertial>
  </link>

  <xacro:actuator_cube name="pitch_actuator" colour="actuator_purple" gazebo_colour="Gazebo/Purple"/>
  <xacro:output_shaft name="shoulder_pitch_shaft" length="${transfer_shaft_length}"
                      xyz="0 ${side*transfer_shaft_center} 0" rpy="${pi/2.0} 0 0"/>
  <xacro:actuator_cube name="roll_actuator" colour="actuator_green" gazebo_colour="Gazebo/Green"/>
  <xacro:output_shaft name="shoulder_roll_shaft" length="${transfer_shaft_length}"
                      xyz="${transfer_shaft_center} 0 0" rpy="0 ${pi/2.0} 0"/>
  <xacro:actuator_cube name="yaw_actuator" colour="actuator_cyan" gazebo_colour="Gazebo/Turquoise"/>
  <xacro:output_shaft name="shoulder_yaw_link" length="${yaw_shaft_length}"
                      xyz="0 0 ${-yaw_shaft_center}" rpy="0 0 0"/>

  <!-- upper arm.
       Fixed to yaw output, separated from its housing by exposed shaft.
       Frame at its top centre, preserving the original box dimensions. -->
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 ${-ual/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${uad} ${uaw} ${ual}"/>
      </geometry>
      <material name="copper"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${-ual/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${uad} ${uaw} ${ual}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${-ual/2}" rpy="0 0 0"/>
      <mass value="${upper_arm_mass}"/>
      <inertia
        ixx="${upper_arm_mass*(uaw*uaw + ual*ual)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${upper_arm_mass*(uad*uad + ual*ual)/12.0}" iyz="0.0"
        izz="${upper_arm_mass*(uad*uad + uaw*uaw)/12.0}"/>
    </inertial>
  </link>

  <!-- ================= joints ================= -->

  <joint name="world_to_stem" type="fixed">
    <parent link="world"/>
    <child  link="stem"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Lands the crossbar frame exactly on the top face of the stem. -->
  <joint name="stem_to_crossbar" type="fixed">
    <parent link="stem"/>
    <child  link="crossbar"/>
    <origin xyz="0 0 ${sh}" rpy="0 0 0"/>
  </joint>

  <!-- Pitch is FIRST, as on the G1; the purple stator stays on the bar. -->
  <joint name="crossbar_to_pitch_actuator" type="fixed">
    <parent link="crossbar"/>
    <child link="pitch_actuator"/>
    <origin xyz="0 ${shoulder_y} ${shoulder_z}" rpy="0 0 0"/>
  </joint>

  <!-- Preserve the pitch joint name used by the GUI. -->
  <joint name="shoulder_joint" type="continuous">
    <parent link="pitch_actuator"/>
    <child link="shoulder_pitch_shaft"/>
    <origin xyz="0 ${side*actuator_size/2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="${shoulder_damping}" friction="${shoulder_friction}"/>
  </joint>

  <joint name="pitch_output_to_roll_actuator" type="fixed">
    <parent link="shoulder_pitch_shaft"/>
    <child link="roll_actuator"/>
    <origin xyz="0 ${side*next_housing_offset} 0" rpy="0 0 0"/>
  </joint>

  <!-- Roll is SECOND; its bore is below the incoming pitch shaft. -->
  <joint name="shoulder_roll_joint" type="continuous">
    <parent link="roll_actuator"/>
    <child link="shoulder_roll_shaft"/>
    <origin xyz="${actuator_size/2.0} 0 ${-roll_axis_drop}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="${shoulder_damping}" friction="${shoulder_friction}"/>
  </joint>

  <!-- The roll shaft passes through the upper part of the yaw cube. -->
  <joint name="roll_output_to_yaw_actuator" type="fixed">
    <parent link="shoulder_roll_shaft"/>
    <child link="yaw_actuator"/>
    <origin xyz="${next_housing_offset} 0 ${-roll_axis_drop}" rpy="0 0 0"/>
  </joint>

  <!-- Yaw is THIRD: twist about the hanging arm's own centreline. -->
  <joint name="shoulder_yaw_joint" type="continuous">
    <parent link="yaw_actuator"/>
    <child link="shoulder_yaw_link"/>
    <origin xyz="0 0 ${-actuator_size/2.0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="${shoulder_damping}" friction="${shoulder_friction}"/>
  </joint>

  <joint name="yaw_output_to_upper_arm" type="fixed">
    <parent link="shoulder_yaw_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 ${-shaft_gap}" rpy="0 0 0"/>
  </joint>

  <!--
    STAGE 4 goes here - forearm on an elbow joint, hanging off the bottom
    of the upper arm at xyz="0 0 ${-ual}" in its own link frame.
  -->

  <!-- ================= gazebo ================= -->

  <gazebo reference="stem">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="crossbar">
    <material>Gazebo/SkyBlue</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="upper_arm">
    <material>Gazebo/Orange</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- Exposes /gazebo/get_link_state, /gazebo/apply_body_wrench, etc. so the
       rig can be poked from the command line later. -->
  <gazebo>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <robotNamespace>/</robotNamespace>
      <updateRate>50.0</updateRate>
    </plugin>
  </gazebo>

</robot>
