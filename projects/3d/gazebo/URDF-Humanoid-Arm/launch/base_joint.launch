<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="arm_length" default="0.375"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find urdf_humanoid_arm)/urdf/base_joint.urdf.xacro' arm_length:=$(arg arm_length)"/>
  <node name="spawn_base_joint" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model base_joint_rig" output="screen"/>
</launch>