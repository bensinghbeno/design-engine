<?xml version="1.0"?>
<!--
  Spawn a Unitree G1 humanoid in Gazebo Classic.

  Usage:
    roslaunch g1.launch                 # pelvis pinned to world (recommended)
    roslaunch g1.launch pinned:=false   # free-floating, will topple
    roslaunch g1.launch gui:=false      # headless

  The URDFs referenced here are GENERATED by make_g1.py - run that first.
-->
<launch>

  <arg name="pinned" default="true"/>
  <arg name="gui"    default="true"/>
  <arg name="paused" default="false"/>
  <arg name="model"  default="g1"/>
  <arg name="z"      default="0.0"/>

  <arg name="urdf" value="$(find urdf_humanoid)/urdf/g1_pinned.urdf" if="$(arg pinned)"/>
  <arg name="urdf" value="$(find urdf_humanoid)/urdf/g1_free.urdf"   unless="$(arg pinned)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="debug"        value="false"/>
  </include>

  <param name="robot_description" textfile="$(arg urdf)"/>

  <node name="spawn_g1" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model $(arg model) -z $(arg z)"
        respawn="false" output="screen"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

</launch>
