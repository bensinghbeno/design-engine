<?xml version="1.0"?>
<!--
  Unitree G1 standing upright, held by position controllers.

  The pelvis is welded to the world at 0.787 m so the feet rest on the ground,
  and every joint is driven by a position controller, so the robot holds a
  proper upright stance instead of hanging limp.

  Usage:
    roslaunch g1_stand.launch
    roslaunch g1_stand.launch gui:=false

  The URDF is GENERATED by make_g1.py in stand mode; launch-g1-stand.sh
  runs that step for you before starting Gazebo.
-->
<launch>

  <arg name="gui"    default="true"/>
  <arg name="paused" default="false"/>
  <arg name="model"  default="g1"/>
  <!-- When true the 3 waist joints are welded rigid. They then have no
       transmissions, so their controllers must not be spawned. -->
  <arg name="lock_waist" default="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="debug"        value="false"/>
  </include>

  <param name="robot_description"
         textfile="$(find urdf_humanoid)/urdf/g1_stand.urdf"/>

  <!-- gazebo_ros_control runs in the /g1 namespace -->
  <param name="/g1/robot_description"
         textfile="$(find urdf_humanoid)/urdf/g1_stand.urdf"/>

  <node name="spawn_g1" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model $(arg model)"
        respawn="false" output="screen"/>

  <rosparam file="$(find urdf_humanoid)/config/g1_controllers.yaml"
            command="load"/>

  <!-- Controllers WITHOUT the waist (waist is welded rigid) -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen" ns="/g1" if="$(arg lock_waist)"
        args="joint_state_controller
              left_hip_pitch_joint_position_controller
              left_hip_roll_joint_position_controller
              left_hip_yaw_joint_position_controller
              left_knee_joint_position_controller
              left_ankle_pitch_joint_position_controller
              left_ankle_roll_joint_position_controller
              right_hip_pitch_joint_position_controller
              right_hip_roll_joint_position_controller
              right_hip_yaw_joint_position_controller
              right_knee_joint_position_controller
              right_ankle_pitch_joint_position_controller
              right_ankle_roll_joint_position_controller
              left_shoulder_pitch_joint_position_controller
              left_shoulder_roll_joint_position_controller
              left_shoulder_yaw_joint_position_controller
              left_elbow_joint_position_controller
              left_wrist_roll_joint_position_controller
              left_wrist_pitch_joint_position_controller
              left_wrist_yaw_joint_position_controller
              right_shoulder_pitch_joint_position_controller
              right_shoulder_roll_joint_position_controller
              right_shoulder_yaw_joint_position_controller
              right_elbow_joint_position_controller
              right_wrist_roll_joint_position_controller
              right_wrist_pitch_joint_position_controller
              right_wrist_yaw_joint_position_controller"/>

  <!-- Controllers INCLUDING the waist (waist actuated) -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen" ns="/g1" unless="$(arg lock_waist)"
        args="joint_state_controller
              left_hip_pitch_joint_position_controller
              left_hip_roll_joint_position_controller
              left_hip_yaw_joint_position_controller
              left_knee_joint_position_controller
              left_ankle_pitch_joint_position_controller
              left_ankle_roll_joint_position_controller
              right_hip_pitch_joint_position_controller
              right_hip_roll_joint_position_controller
              right_hip_yaw_joint_position_controller
              right_knee_joint_position_controller
              right_ankle_pitch_joint_position_controller
              right_ankle_roll_joint_position_controller
              waist_yaw_joint_position_controller
              waist_roll_joint_position_controller
              waist_pitch_joint_position_controller
              left_shoulder_pitch_joint_position_controller
              left_shoulder_roll_joint_position_controller
              left_shoulder_yaw_joint_position_controller
              left_elbow_joint_position_controller
              left_wrist_roll_joint_position_controller
              left_wrist_pitch_joint_position_controller
              left_wrist_yaw_joint_position_controller
              right_shoulder_pitch_joint_position_controller
              right_shoulder_roll_joint_position_controller
              right_shoulder_yaw_joint_position_controller
              right_elbow_joint_position_controller
              right_wrist_roll_joint_position_controller
              right_wrist_pitch_joint_position_controller
              right_wrist_yaw_joint_position_controller"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen">
    <remap from="/joint_states" to="/g1/joint_states"/>
  </node>

</launch>
