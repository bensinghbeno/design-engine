<?xml version="1.0"?>
<!--
  Unitree G1 upper body mounted on a static pole.

  No legs, no controllers, no PID. The pelvis is welded to a pole that is
  welded to the world, and the 14 arm joints are completely passive - so the
  arms fall under gravity and swing freely, real physics only.

  Usage:
    roslaunch g1_torso.launch
    roslaunch g1_torso.launch gui:=false

  The URDF is GENERATED by make_g1.py in torso mode; launch-g1-torso.sh
  runs that step for you.
-->
<launch>

  <arg name="gui"    default="true"/>
  <arg name="paused" default="false"/>
  <arg name="model"  default="g1_torso"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="debug"        value="false"/>
  </include>

  <param name="robot_description"
         textfile="$(find urdf_humanoid)/urdf/g1_torso.urdf"/>

  <node name="spawn_g1_torso" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model $(arg model)"
        respawn="false" output="screen"/>

</launch>
