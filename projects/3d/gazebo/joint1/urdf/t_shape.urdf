<?xml version=" 1.0\?>
<robot name=\t_shape\>

 <link name=\world\/>

 <joint name=\world_to_stem\ type=\fixed\>
 <parent link=\world\/>
 <child link=\stem\/>
 <origin xyz=\0 0 0\ rpy=\0 0 0\/>
 </joint>

 <link name=\stem\>
 <visual>
 <origin xyz=\0 0 0.5\ rpy=\0 0 0\/>
 <geometry><cylinder radius=\0.05\ length=\1.0\/></geometry>
 <material name=\blue\><color rgba=\0.2 0.4 0.8 1\/></material>
 </visual>
 <collision>
 <origin xyz=\0 0 0.5\ rpy=\0 0 0\/>
 <geometry><cylinder radius=\0.05\ length=\1.0\/></geometry>
 </collision>
 <inertial>
 <origin xyz=\0 0 0.5\/>
 <mass value=\1.0\/>
 <inertia ixx=\0.0840\ ixy=\0\ ixz=\0\ iyy=\0.0840\ iyz=\0\ izz=\0.00125\/>
 </inertial>
 </link>

 <joint name=\stem_to_crossbar\ type=\fixed\>
 <parent link=\stem\/>
 <child link=\crossbar\/>
 <origin xyz=\0 0 1.0\ rpy=\0 0 0\/>
 </joint>

 <link name=\crossbar\>
 <visual>
 <origin xyz=\0 0 0\ rpy=\0 1.5708 0\/>
 <geometry><cylinder radius=\0.05\ length=\0.8\/></geometry>
 <material name=\red\><color rgba=\0.8 0.2 0.2 1\/></material>
 </visual>
 <collision>
 <origin xyz=\0 0 0\ rpy=\0 1.5708 0\/>
 <geometry><cylinder radius=\0.05\ length=\0.8\/></geometry>
 </collision>
 <inertial>
 <origin xyz=\0 0 0\/>
 <mass value=\1.0\/>
 <inertia ixx=\0.00125\ ixy=\0\ ixz=\0\ iyy=\0.0540\ iyz=\0\ izz=\0.0540\/>
 </inertial>
 </link>

</robot>
